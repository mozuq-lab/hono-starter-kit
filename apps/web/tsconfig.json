{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDirs": [".", "./.react-router/types"],
    "types": ["vite/client"],
    "jsx": "react-jsx"
  },
  "include": [
    "app/**/*",
    "e2e/**/*",
    ".react-router/types/**/*",
    "*.ts",
    "../../scripts/externalize-web-scripts.ts"
  ]
}
