# project は bootstrap の project と同じ値にする。IAM の許可範囲と state の key が bootstrap の値から作られる。
project        = "hono-starter-kit"
aws_account_id = "123456789012"
domain_prefix  = "hono-starter-kit-dev-example"

# 次の 3 つは必須で、手順は docs/aws.md の「4. API イメージを公開し、dev の値を埋める」にある。
# 値を決めたら行頭の # を外す。

# bootstrap の output ecr_repository_arn。
#   pnpm -s terraform -- --root bootstrap output -raw ecr_repository_arn
# api_repository_arn = "arn:aws:ecr:ap-northeast-1:123456789012:repository/hono-starter-kit-dev-api"

# 公式 AWS ADOT コレクターのイメージを digest で固定したもの。
#   docker buildx imagetools inspect public.ecr.aws/aws-observability/aws-otel-collector:<バージョンのタグ>
# adot_image = "public.ecr.aws/aws-observability/aws-otel-collector@sha256:<64 桁の digest>"

# 上の ECR リポジトリへ push した API イメージを digest で固定したもの。pnpm release:api が、
# push したイメージの値をこのファイルの末尾に書き込むので、手で書く必要はない。
# api_image = "123456789012.dkr.ecr.ap-northeast-1.amazonaws.com/hono-starter-kit-dev-api@sha256:<64 桁の digest>"
